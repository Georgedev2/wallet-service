PORT=3600

DATABASE_URL=postgres://postgres:postgres@localhost:5433/wallet_dev
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/wallet_test
# Set to true for managed Postgres that requires TLS
DATABASE_SSL=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# Seeded admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Optional: defaults to +2340000000000 and Administrator
ADMIN_PHONE=+2340000000000
ADMIN_FULL_NAME=Administrator
